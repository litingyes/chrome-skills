#!/usr/bin/env python3
"""Extract structured data from the current browser session."""

from __future__ import annotations

import argparse
import asyncio
import sys
from pathlib import Path

SCRIPTS_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPTS_DIR))

import lib  # noqa: F401

from lib.cli_helpers import emit, emit_error
from lib.extract_article import extract_article
from lib.extract_a11y import extract_a11y
from lib.extract_search import extract_serp
from lib.layout_probe import extract_layout


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Extract structured page data")
    sub = parser.add_subparsers(dest="mode", required=True)

    article = sub.add_parser("article", help="Extract article JSON from current page")
    article.add_argument("--session", required=True)

    serp = sub.add_parser("serp", help="Extract Google SERP from current page")
    serp.add_argument("--session", required=True)
    serp.add_argument("--limit", type=int, default=10)

    layout = sub.add_parser("layout", help="Extract layout metrics and UI issues")
    layout.add_argument("--session", required=True)
    layout.add_argument(
        "--selectors",
        help="Comma-separated CSS selectors (default: main,nav,header,buttons,...)",
    )
    layout.add_argument(
        "--rules",
        help="Comma-separated rules: spacing,alignment,overflow,touch-target,blank",
    )

    a11y = sub.add_parser("a11y", help="Extract accessibility tree and a11y issues")
    a11y.add_argument("--session", required=True)

    return parser


def _parse_csv(value: str | None) -> list[str] | None:
    if not value:
        return None
    return [item.strip() for item in value.split(",") if item.strip()]


async def run_async(args: argparse.Namespace) -> dict:
    if args.mode == "article":
        return await extract_article(args.session)
    if args.mode == "serp":
        return await extract_serp(args.session, limit=args.limit)
    if args.mode == "layout":
        return await extract_layout(
            args.session,
            selectors=_parse_csv(args.selectors),
            rules=_parse_csv(args.rules),
        )
    if args.mode == "a11y":
        return await extract_a11y(args.session)
    raise ValueError(f"Unknown mode: {args.mode}")


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    try:
        emit(asyncio.run(run_async(args)))
    except Exception as exc:
        emit_error(str(exc))


if __name__ == "__main__":
    main()
